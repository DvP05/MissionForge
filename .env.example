# App metadata used in the JPL User-Agent. Set a monitored project contact.
APP_NAME=MISSIONFORGE
APP_VERSION=0.1.0
APP_CONTACT_EMAIL=team@example.com

# JPL SSD mission-design endpoint (server-side only)
JPL_MDESIGN_BASE_URL=https://ssd-api.jpl.nasa.gov/mdesign.api
JPL_REQUEST_TIMEOUT_MS=10000
JPL_CACHE_TTL_A_SECONDS=43200
JPL_CACHE_TTL_Q_SECONDS=86400
JPL_CACHE_TTL_M_SECONDS=21600
# Live JPL access is opt-in (ruling R6): needs JPL_LIVE_ENABLED=1 AND a real APP_CONTACT_EMAIL.
# Otherwise the bundled offline snapshot (data/jpl/demo-snapshot.json) is served and labelled.
JPL_LIVE_ENABLED=0
# Force the offline snapshot even when live access is enabled (demo rehearsal).
JPL_FORCE_OFFLINE=0

# Python domain model / service versions
MISSION_SCHEMA_VERSION=1.0
# Engine and catalogue versions are not configurable (R40): they come from the engine
# constant and data/catalog/manifest, so they can never disagree with the analysis.

# Frontend -> Python API base URL (local default)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
